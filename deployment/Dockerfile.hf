# Hugging Face Spaces — Docker SDK
# Free tier: 2 vCPU, 16 GB RAM, 50 GB disk
# Docs: https://huggingface.co/docs/hub/spaces-sdks-docker
FROM python:3.11-slim

# HF Spaces requires the app to run as non-root user (uid 1000)
RUN useradd -m -u 1000 user

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/user

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create writable directories for the non-root user
RUN mkdir -p /app/data/chroma_db /app/data/rag_uploads /app/data/bhavcopy_cache /app/data/event_logs \
    && chown -R user:user /app

# Switch to non-root user (HF Spaces requirement)
USER user

# HF Spaces exposes port 7860 by default
EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl --fail http://localhost:7860/api/v1/health || exit 1

COPY deployment/start.sh /app/start.sh

CMD ["bash", "/app/start.sh"]
